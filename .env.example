# Copy this file to .env and fill in the values

PORT=3000

# Long random string used to sign JWTs (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET= Your Token Here

# Google OAuth2 "Web application" client ID (see README, step 2)
GOOGLE_CLIENT_ID= Your ID Here
GOOGLE_CLIENT_SECRET= Your Token Here

# Coach account, created on first start (change the password before going public!)
COACH_USERNAME= Coach Username Here
COACH_PASSWORD= Coach Password Here

# Free AI model for the chatbot. Any OpenAI-compatible provider works.
# Default: Groq free tier. Get a key at https://console.groq.com
AI_API_KEY= Your API Key Here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Other free options:
#  Google Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=<a current Gemini Flash model>
#  OpenRouter    : AI_BASE_URL=https://openrouter.ai/api/v1                              AI_MODEL=<any model ending in :free>
